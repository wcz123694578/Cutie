<Window x:Class="Cutie.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cutie.Views"
        xmlns:vm="clr-namespace:Cutie.ViewModels"
        mc:Ignorable="d"
        Title="SettingsView" Height="450" Width="800">
    <Window.DataContext>
        <vm:SettingsViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="20" Grid.Row="0">
            <TextBlock Text="MCP服务端口号"
                       FontWeight="Bold"/>
            <TextBox Margin="0 5 0 0"
                     HorizontalAlignment="Left"
                     Width="200"
                     Text="{Binding McpServerPort, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
        </StackPanel>
        <Grid Grid.Row="1"
              Background="AliceBlue">
            <Button Width="80"
                    Content="保存"
                    HorizontalAlignment="Right"
                    Command="{Binding SaveSettingsCommand}"
                    Margin="20"/>
        </Grid>
    </Grid>
</Window>
